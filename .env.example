# Create a Supabase project, run supabase/migrations/001_initial.sql, then copy
# this file to .env.local. These are public client settings; never put a
# service_role or secret key in any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example/privacidade.html
EXPO_PUBLIC_SUPPORT_EMAIL=suporte@your-domain.example
